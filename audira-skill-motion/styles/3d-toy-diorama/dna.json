{
  "$schema": "https://audira.io/schemas/visual-dna.v1.json",
  "styleId": "3d-toy-diorama",
  "styleNumber": 31,
  "name": "Stylized 3D Toy Diorama & Theatrical Miniature Stage",
  "version": "1.0.0",
  "palette": {
    "background": "#0D0F14",
    "stageFloor": "#2A1810",
    "stageGold": "#D4AF37",
    "primary": "#E0A96D",
    "secondary": "#202020",
    "accent": "#FF5E3A",
    "neutral": "#EBE3D5",
    "tapeKraft": "#D2B48C",
    "text": "#FFFFFF"
  },
  "geometry": {
    "type": "blocky_beveled",
    "bevelRadius": 0.08,
    "polyBudget": "low_to_mid",
    "silhouette": "chunky_geometric"
  },
  "materials": {
    "type": "matte_pbr_plastic",
    "roughness": 0.78,
    "metalness": 0.02,
    "subsurfaceScatter": 0.12,
    "normalMap": "micro_plastic_grain"
  },
  "lighting": {
    "archetype": "four_source_theatrical",
    "keyLight": { "kelvin": 3200, "intensity": 1.4, "angle": [35, 45, 20] },
    "fillLight": { "kelvin": 4800, "intensity": 0.35, "angle": [-40, 20, 10] },
    "rimLight": { "kelvin": 5600, "intensity": 0.85, "angle": [180, 60, -30] },
    "footlights": { "kelvin": 2700, "intensity": 1.1, "count": 7 },
    "ambientOcclusion": { "intensity": 0.8, "radius": 0.3 }
  },
  "camera": {
    "type": "theatrical_macro",
    "focalLengthMm": 50,
    "fovDeg": 32,
    "position": [0, 1.25, 4.6],
    "target": [0, 0.75, 0],
    "depthOfField": { "enabled": true, "fStop": 2.8 },
    "motionConstraint": "strictly_static"
  },
  "motion": {
    "fps": 60,
    "physicsModel": "spring_damped",
    "spring": { "stiffness": 180, "damping": 15, "mass": 1.0 },
    "characterCadence": "snappy_organic",
    "blinkCadenceFrames": 180
  }
}

