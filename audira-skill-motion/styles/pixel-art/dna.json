{
  "$schema": "https://audira.io/schemas/visual-dna.v1.json",
  "styleId": "pixel-art",
  "name": "2.5D Retro Pixel Art & 16-Bit Nostalgia Platformer",
  "kit": "pixelstory",
  "category": "Pixel Art / Retro 16-Bit",
  "palette": {
    "background": "#181425",
    "primary": "#FF0055",
    "secondary": "#265C42",
    "accent": "#FEE761",
    "neutral": "#639BFF",
    "text": "#FFFFFF"
  },
  "geometry": {
    "type": "pixel_billboard_voxels",
    "bevelRadius": 0,
    "polyBudget": "sprite_quads",
    "silhouette": "stepped_pixel_grid"
  },
  "materials": {
    "type": "nearest_neighbor_diffuse",
    "roughness": 1,
    "metalness": 0,
    "clearcoat": 0,
    "normalMap": "none"
  },
  "lighting": {
    "archetype": "ambient_chiptune_glow",
    "keyLight": {
      "kelvin": 5000,
      "intensity": 1,
      "angle": [
        0,
        0,
        0
      ]
    },
    "fillLight": {
      "kelvin": 5000,
      "intensity": 0.5
    },
    "rimLight": {
      "kelvin": 5000,
      "intensity": 0
    }
  },
  "camera": {
    "type": "side_scroller_ortho",
    "focalLengthMm": 50,
    "fovDeg": 30,
    "depthOfField": {
      "enabled": false
    },
    "motionConstraint": "pixel_grid_scroll"
  },
  "motion": {
    "fps": 60,
    "physicsModel": "stepped_sprite_frames",
    "characterCadence": "8frame_run_cycle"
  }
}