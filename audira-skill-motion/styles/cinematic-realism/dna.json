{
  "$schema": "https://audira.io/schemas/visual-dna.v1.json",
  "styleId": "cinematic-realism",
  "name": "Cinematic Realism & Environmental Worldbuilding",
  "kit": "worldforge",
  "category": "Photorealistic / World Exploration",
  "palette": {
    "background": "#080A0F",
    "primary": "#2D4B73",
    "secondary": "#1A2634",
    "accent": "#E5A93C",
    "neutral": "#C4CCD4",
    "text": "#FFFFFF"
  },
  "geometry": {
    "type": "subdivision_terrain",
    "bevelRadius": 0.02,
    "polyBudget": "ultra_high",
    "silhouette": "organic_naturalistic"
  },
  "materials": {
    "type": "pbr_photoreal",
    "roughness": 0.65,
    "metalness": 0.15,
    "clearcoat": 0.05,
    "normalMap": "megascans_rock_soil"
  },
  "lighting": {
    "archetype": "natural_sun_hdri",
    "keyLight": {
      "kelvin": 5400,
      "intensity": 2,
      "angle": [
        45,
        60,
        0
      ]
    },
    "fillLight": {
      "kelvin": 6500,
      "intensity": 0.4
    },
    "rimLight": {
      "kelvin": 5800,
      "intensity": 1.2
    }
  },
  "camera": {
    "type": "cinematic_anamorphic_crane",
    "focalLengthMm": 35,
    "fovDeg": 42,
    "depthOfField": {
      "enabled": true,
      "fStop": 2.8
    },
    "motionConstraint": "slow_sweeping_crane"
  },
  "motion": {
    "fps": 60,
    "physicsModel": "smooth_cinematic_inertia",
    "characterCadence": "naturalistic_human"
  }
}