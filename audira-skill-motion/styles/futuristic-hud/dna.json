{
  "$schema": "https://audira.io/schemas/visual-dna.v1.json",
  "styleId": "futuristic-hud",
  "name": "Sci-Fi Quantum Hologram & Cybernetic HUD Telemetry",
  "kit": "cyberforge",
  "category": "Futuristic Sci-Fi UI / Hologram",
  "palette": {
    "background": "#040711",
    "primary": "#00F0FF",
    "secondary": "#0A2540",
    "accent": "#7928CA",
    "neutral": "#1F3A60",
    "text": "#E0F7FF"
