{
  "$schema": "https://audira.io/schemas/visual-dna.v1.json",
  "styleId": "y2k-chrome",
  "styleNumber": 54,
  "name": "Y2K Liquid Chrome & Frutiger Aero",
  "version": "1.0.0",
  "palette": {
    "skyTop": "#1259E8",
    "skyMid": "#3FB8FF",
    "skyHorizon": "#E9FBFF",
    "skyLow": "#7EE8D6",
    "chrome": "#F2F6FA",
    "iriPink": "#FF8AD8",
    "iriLime": "#B8FF6A",
