  },
  "geometry": {
    "type": "displaced_sphere_blob_and_superellipse_sparkles",
    "bevelRadius": 0.03,
    "polyBudget": "mid",
    "silhouette": "soft_liquid_rounded"
  },
  "materials": {
    "type": "sky_reflecting_chrome_and_iridescent_bubble",
    "roughness": 0.04,
