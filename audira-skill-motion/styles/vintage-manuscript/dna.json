{
  "$schema": "https://audira.io/schemas/visual-dna.v1.json",
  "styleId": "vintage-manuscript",
  "name": "Da Vinci Antique Manuscript & Copperplate Engraving",
  "kit": "vintageforge",
  "category": "Renaissance Manuscript / Parchment",
  "palette": {
    "background": "#2E2215",
    "primary": "#3B2716",
    "secondary": "#C8A97E",
    "accent": "#7A1C16",
    "neutral": "#D8C2A0",
    "text": "#2A180E"
  },
  "geometry": {
    "type": "florentine_parchment_scroll",
    "bevelRadius": 0.01,
    "polyBudget": "mid_deckled_scroll",
    "silhouette": "sepia_renaissance_lines"
  },
  "materials": {
    "type": "aged_vellum_parchment",
    "roughness": 0.95,
    "metalness": 0,
    "normalMap": "leather_parchment_crinkle"
  },
  "lighting": {
    "archetype": "candle_flicker_warm",
    "keyLight": {
      "kelvin": 2400,
      "intensity": 1.3,
      "angle": [
        30,
        40,
        10
      ]
    },
    "fillLight": {
      "kelvin": 2800,
      "intensity": 0.4
    },
    "rimLight": {
      "kelvin": 2200,
      "intensity": 0.7
    }
  },
  "camera": {
    "type": "manuscript_macro_pan",
    "focalLengthMm": 70,
    "fovDeg": 28,
    "depthOfField": {
      "enabled": true,
      "fStop": 2.4
    },
    "motionConstraint": "copperplate_hatching_reveal"
  },
  "motion": {
    "fps": 60,
    "physicsModel": "ink_quill_drawing_flow",
    "characterCadence": "renaissance_invention"
  }
}