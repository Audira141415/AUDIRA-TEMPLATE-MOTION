{
  "$schema": "https://audira.io/schemas/visual-dna.v1.json",
  "styleId": "anime",
  "name": "Cel-Shaded 3D Anime & Manga Speed Lines",
  "kit": "toonforge",
  "category": "Stylized Japanese Anime",
  "palette": {
    "background": "#0F121C",
    "primary": "#FF3366",
    "secondary": "#1E2438",
    "accent": "#00F0FF",
    "neutral": "#F0F4F8",
    "text": "#FFFFFF"
  },
  "geometry": {
    "type": "cel_shaded_contour",
    "bevelRadius": 0.03,
    "polyBudget": "mid_to_high",
    "silhouette": "dynamic_sharp_action"
  },
  "materials": {
    "type": "cel_toon_stepped",
    "roughness": 0.3,
    "metalness": 0,
    "inkOutlineWidth": 2.5,
    "normalMap": "flat_ink_contour"
  },
  "lighting": {
    "archetype": "high_key_anime_two_tone",
    "keyLight": {
      "kelvin": 6000,
      "intensity": 1.8,
      "angle": [
        30,
        45,
        0
      ]
    },
    "fillLight": {
      "kelvin": 7500,
      "intensity": 0.6
    },
    "rimLight": {
      "kelvin": 9000,
      "intensity": 2.2
    }
  },
  "camera": {
    "type": "action_snap_zoom",
    "focalLengthMm": 75,
    "fovDeg": 28,
    "depthOfField": {
      "enabled": false
    },
    "motionConstraint": "whip_pan_snap_zoom"
  },
  "motion": {
    "fps": 60,
    "physicsModel": "stepped_keyframe_anime",
    "characterCadence": "explosive_action"
  }
}