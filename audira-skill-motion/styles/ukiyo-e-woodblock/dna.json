{
  "$schema": "https://audira.io/schemas/visual-dna.v1.json",
  "styleId": "ukiyo-e-woodblock",
  "styleNumber": 57,
  "name": "Ukiyo-e Woodblock Print & Layered Waves",
  "kit": "ukiyoforge",
  "version": "1.0.0",
  "palette": {
    "background": "#0F2747",
    "prussian": "#1F4A7A",
    "indigoWash": "#9DB5CC",
    "vermilion": "#D9472B",
    "ochre": "#D9A441",
    "keyLine": "#1B1A1F",
    "washi": "#EFE3C8",
    "text": "#0F2747"
  },
  "geometry": {
    "type": "layered_paper_print_sheets",
    "bevelRadius": 0.0,
    "polyBudget": "very_low_planes",
    "silhouette": "claw_foam_wave_and_cutout_edges"
  },
  "materials": {
    "type": "washi_woodblock_ink",
    "roughness": 0.96,
    "metalness": 0.0,
    "normalMap": "none_canvas_fibre_grain"
  },
  "lighting": {
    "archetype": "flat_print_with_paper_drop_shadows",
    "keyLight": { "kelvin": 5200, "intensity": 1.1, "angle": [18, -14, 0], "shadow": "pcf_soft_2048" },
    "fillLight": { "kelvin": 5600, "intensity": 1.55, "type": "ambient" },
    "toneMapping": "none"
  },
  "camera": {
    "type": "trough_to_print_eye",
    "focalLengthMm": 24,
    "fovDeg": 58,
    "position": [1.5, -1.7, 2.9],
    "motionConstraint": "settle_on_print_eye_z9"
  },
  "motion": {
    "fps": 60,
    "physicsModel": "layer_heave_and_ballistic_spray",
    "characterCadence": "tidal"
  }
}
