{
  "$schema": "https://audira.io/schemas/visual-dna.v1.json",
  "styleId": "devforge",
  "name": "3D Spatial IDE & Game Dev Hustle Engine",
  "kit": "devforge",
  "category": "Tech Developer / 3D Spatial Computing",
  "palette": {
    "background": "#0A0D14",
    "primary": "#00FF66",
    "secondary": "#1E2638",
    "accent": "#7928CA",
    "neutral": "#A0AEC0",
    "text": "#FFFFFF"
  },
  "geometry": {
    "type": "spatial_floating_ide_slabs",
    "bevelRadius": 0.04,
    "polyBudget": "mid_poly",
    "silhouette": "clean_ui_slabs_floating"
  },
  "materials": {
    "type": "frosted_acrylic_dark",
    "roughness": 0.45,
    "metalness": 0.05,
    "transmission": 0.2,
    "normalMap": "subtle_sandblast"
  },
  "lighting": {
    "archetype": "ambient_terminal_glow",
    "keyLight": {
      "kelvin": 6500,
      "intensity": 1.4,
      "angle": [
        30,
        45,
        0
      ]
    },
    "fillLight": {
      "kelvin": 8000,
      "intensity": 0.4
    },
    "rimLight": {
      "kelvin": 7000,
      "intensity": 1.2
    }
  },
  "camera": {
    "type": "floating_developer_headset",
    "focalLengthMm": 35,
    "fovDeg": 55,
    "depthOfField": {
      "enabled": true,
      "fStop": 3.5
    },
    "motionConstraint": "smooth_yaw_float"
  },
  "motion": {
    "fps": 60,
    "physicsModel": "typewriter_spring_physics",
    "characterCadence": "hustle_code_velocity"
  }
}