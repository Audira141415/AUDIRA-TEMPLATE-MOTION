{
  "$schema": "https://audira.io/schemas/visual-dna.v1.json",
  "styleId": "cyberpunk",
  "name": "Cyberpunk Cinematic Megacity & Neon Rain Alley",
  "kit": "innerworks",
  "category": "Sci-Fi Megacity / Atmospheric Neon",
  "palette": {
    "background": "#05070E",
    "primary": "#FF007F",
    "secondary": "#00F5FF",
    "accent": "#FFE600",
    "neutral": "#181E2E",
    "text": "#FFFFFF"
  },
  "geometry": {
    "type": "dense_greeble_megastructure",
    "bevelRadius": 0.01,
    "polyBudget": "ultra_high",
    "silhouette": "towering_skyscrapers_cables"
  },
  "materials": {
    "type": "wet_cyber_metallic",
    "roughness": 0.22,
    "metalness": 0.65,
    "clearcoat": 0.9,
    "normalMap": "rain_streaked_metal_glass"
  },
  "lighting": {
    "archetype": "neon_noir_multi_tint",
    "keyLight": {
      "kelvin": 9000,
      "intensity": 2.2,
      "angle": [
        40,
        50,
        15
      ]
    },
    "fillLight": {
      "kelvin": 2800,
      "intensity": 0.5
    },
    "rimLight": {
      "kelvin": 12000,
      "intensity": 2
    }
  },
  "camera": {
    "type": "flying_drone_fpv_street",
    "focalLengthMm": 28,
    "fovDeg": 65,
    "depthOfField": {
      "enabled": true,
      "fStop": 1.8
    },
    "motionConstraint": "cinematic_forward_glide"
  },
  "motion": {
    "fps": 60,
    "physicsModel": "smooth_flight_aerodynamic",
    "characterCadence": "high_tech_flicker"
  }
}