{
  "$schema": "https://audira.io/schemas/visual-dna.v1.json",
  "styleId": "risograph-print",
  "styleNumber": 53,
  "name": "Risograph Zine Print — Spot-Ink Overprint Pop-Up",
  "kit": "risoforge",
  "version": "1.0.0",
  "palette": {
    "fluoPink": "#FF48B0",
    "blue": "#0078BF",
    "yellow": "#FFE800",
    "paper": "#F6F0E2",
    "mat": "#7FA59A",
