{
  "$schema": "https://audira.io/schemas/visual-dna.v1.json",
  "styleId": "sports-tactic-board",
  "styleNumber": 46,
  "name": "Sports Tactic Board & Broadcast Analysis",
  "version": "1.0.0",
  "palette": {
    "void": "#070B10",
    "grassLight": "#46A04C",
    "grassDark": "#337F39",
    "chalk": "#F4F6EE",
    "home": "#FF5A3C",
    "away": "#2F7BFF",
    "lane": "#FFE27A",
    "run": "#FF8A6A",
    "goalGold": "#FFC94A",
    "text": "#E8FFF0"
  },
  "geometry": {
    "type": "miniature_pitch_board_with_puck_tokens",
    "bevelRadius": 0.01,
    "polyBudget": "low",
    "silhouette": "round_tokens_on_rectilinear_pitch"
  },
  "materials": {
    "type": "painted_turf_and_glossy_acrylic",
    "roughness": 0.86,
    "metalness": 0.0,
    "tokenRoughness": 0.28,
    "normalMap": "none_canvas_speckle"
  },
  "lighting": {
    "archetype": "stadium_floodlight_key_with_cool_rim",
    "keyLight": {
      "kelvin": 6500,
      "intensity": 2.4,
      "angle": [
        60,
        45,
        0
      ]
    },
    "fillLight": {
      "kelvin": 7500,
      "intensity": 0.55
    },
    "ambientOcclusion": {
      "intensity": 0.0,
      "radius": 0.0
    }
  },
  "camera": {
    "type": "broadcast_analysis_sweep",
    "focalLengthMm": 30,
    "fovDeg": 42,
    "position": [
      0.4,
      12.6,
      6.2
    ],
    "motionConstraint": "overhead_to_low_pitchside_catmull_rom"
  },
  "motion": {
    "fps": 60,
    "physicsModel": "keyed_player_tracks_ball_lift_arcs",
    "characterCadence": "match_tempo"
  }
}
